# Host-specific template, not a runnable production configuration.
# Replace every REPLACE value and documentation IP before starting coturn.
# Keep the final file private (0600); never commit it or its shared secret.
listening-ip=10.0.0.10
relay-ip=10.0.0.10
external-ip=203.0.113.10/10.0.0.10
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49260
realm=REPLACE_WITH_TURN_HOSTNAME
server-name=REPLACE_WITH_TURN_HOSTNAME
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_SIGNALING
fingerprint
cert=/REPLACE_WITH_CERTIFICATE_PATH/fullchain.pem
pkey=/REPLACE_WITH_PRIVATE_KEY_PATH/privkey.pem
no-dtls
no-cli
no-tcp-relay
no-multicast-peers
stale-nonce=600
max-allocate-lifetime=900
user-quota=8
total-quota=100
max-bps=10485760
bps-capacity=104857600

# Block relay access to local/private/metadata networks. Loopback peers remain
# disabled by default. Keep the host firewall's egress policy consistent.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Logs can contain network metadata and temporary usernames. Set retention at
# the host; do not enable verbose or Binding-request logging in production.
log-file=stdout
