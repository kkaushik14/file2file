{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "file2file-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING", "class_name": "SignalingHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingHub"] }],
  "observability": { "enabled": false },
}
