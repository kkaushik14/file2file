# Local defaults. Never put file keys, PINs or TURN secrets in NEXT_PUBLIC variables.
TRANSFER_NETWORK=local
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8787
# Signaling also starts same-machine STUN on fixed 127.0.0.1:8788/udp.
# This helper never follows SIGNAL_HOST onto a public interface.
SIGNAL_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:4174
# Build-time public endpoint; defaults to loopback in local browsers only.
NEXT_PUBLIC_SIGNAL_URL=

# To use coturn, set TRANSFER_NETWORK=turn and fill in your own endpoints.
# STUN_URLS=stun:turn.example.com:3478
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET_FILE=/absolute/private/path/turn-secret
# all = prefer direct with relay fallback; relay = force TURN for verification.
# ICE_TRANSPORT_POLICY=all
# Set SIGNAL_ORIGINS to the exact HTTPS frontend origin for hosted use.
# NEXT_PUBLIC_SIGNAL_URL=wss://signal.example.com
